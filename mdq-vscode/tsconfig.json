{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["node"],
		"paths": {
			"mdq": ["../mdq-js/src/index.ts"],
			"mdq/solid": ["../mdq-js/src/solid/index.ts"]
		},
		"noEmit": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js"
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"tests/**/*.ts",
		"../mdq-js/src/types/*.d.ts"
	]
}
