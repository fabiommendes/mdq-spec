{
	"name": "mdq",
	"displayName": "MDQ",
	"description": "Validation and preview of MDQ documents: questions and exams written in Markdown, YAML or JSON.",
	"version": "0.0.1",
	"publisher": "fabiomendes",
	"preview": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fabiommendes/mdq-vscode.git"
	},
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Linters",
		"Education"
	],
	"keywords": [
		"mdq",
		"quiz",
		"exam",
		"markdown",
		"questions"
	],
	"main": "./dist/extension.cjs",
	"activationEvents": [
		"onLanguage:markdown",
		"onLanguage:mdq",
		"onLanguage:yaml",
		"onLanguage:json"
	],
	"extensionDependencies": [
		"redhat.vscode-yaml"
	],
	"contributes": {
		"languages": [
			{
				"id": "mdq",
				"aliases": [
					"MDQ",
					"mdq"
				],
				"extensions": [
					".mdq"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "mdq",
				"scopeName": "text.html.markdown.mdq",
				"path": "./syntaxes/mdq.tmLanguage.json"
			}
		],
		"commands": [
			{
				"command": "mdq.showPreview",
				"title": "Open Preview",
				"category": "MDQ",
				"icon": "$(open-preview)"
			},
			{
				"command": "mdq.showPreviewToSide",
				"title": "Open Preview to the Side",
				"category": "MDQ",
				"icon": "$(open-preview)"
			}
		],
		"menus": {
			"editor/title": [
				{
					"command": "mdq.showPreviewToSide",
					"when": "mdq.isMdqEditor",
					"group": "navigation"
				}
			],
			"commandPalette": [
				{
					"command": "mdq.showPreview",
					"when": "mdq.isMdqEditor"
				},
				{
					"command": "mdq.showPreviewToSide",
					"when": "mdq.isMdqEditor"
				}
			]
		},
		"keybindings": [
			{
				"command": "mdq.showPreviewToSide",
				"key": "ctrl+k v",
				"mac": "cmd+k v",
				"when": "editorTextFocus && mdq.isMdqEditor"
			}
		],
		"jsonValidation": [
			{
				"fileMatch": "*.mdq.json",
				"url": "./dist/mdq.schema.json"
			}
		],
		"yamlValidation": [
			{
				"fileMatch": [
					"*.mdq.yaml",
					"*.mdq.yml"
				],
				"url": "./dist/mdq.schema.json"
			}
		],
		"configuration": {
			"title": "MDQ",
			"properties": {
				"mdq.files": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "resource",
					"markdownDescription": "Globs of Markdown files to read as MDQ, relative to the workspace folder, such as `questoes/**/*.md`. The files stay Markdown for the editor. A Markdown file whose frontmatter declares an MDQ `type` is read as MDQ without a glob."
				},
				"mdq.diagnostics.info": {
					"type": "string",
					"enum": [
						"information",
						"hint",
						"off"
					],
					"enumDescriptions": [
						"Show info diagnostics with a squiggle and in the Problems panel.",
						"Show info diagnostics as faint dots, not in the Problems panel.",
						"Do not show info diagnostics."
					],
					"default": "hint",
					"description": "How to show diagnostics of the `info` level, such as a missing id or title."
				}
			}
		}
	},
	"scripts": {
		"build": "node build.mjs",
		"watch": "node build.mjs --watch",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome check",
		"package": "node build.mjs --production && vsce package --no-dependencies"
	},
	"packageManager": "pnpm@10.15.1",
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@types/node": "^22.0.0",
		"@types/vscode": "~1.90.0",
		"@vscode/vsce": "^3.2.0",
		"esbuild": "^0.25.0",
		"esbuild-plugin-solid": "^0.6.0",
		"solid-js": "^1.9.18",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
