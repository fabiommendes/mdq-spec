{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"types": ["vite/client", "node"],
		"baseUrl": ".",
		"paths": {
			"@mdq": ["../src/index.ts"],
			"@mdq/*": ["../src/*"]
		}
	},
	"include": [
		"../src/types/*.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"e2e/**/*.ts",
		"*.ts"
	],
	"exclude": ["node_modules", "dist", "test-results", "playwright-report"]
}
